#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-}"
shift || true

last_arg=""
for arg in "$@"; do
  last_arg="$arg"
done

if [[ "$last_arg" == "--execute" ]]; then
  case "$command_name" in
    send|mark-read|archive|mute)
      printf '%s\n' "$command_name" >> "${MOCK_EXECUTE_LOG:?}"
      printf '{"ok":true,"action":"%s"}\n' "$command_name"
      exit 0
      ;;
    *)
      echo "unexpected execute command: $command_name" >&2
      exit 2
      ;;
  esac
fi

case "$command_name" in
  dialogs|messages|search|unread-dialogs|unread-dms)
    printf '[{"id":1,"name":"Mock Chat"}]\n'
    ;;
  send)
    printf '{"dry_run":true,"action":"send","chat":{"id":1,"name":"Mock Chat"},"text":"mock"}\n'
    ;;
  mark-read|archive|mute)
    printf '{"dry_run":true,"action":"%s","chat":{"id":1,"name":"Mock Chat"}}\n' "$command_name"
    ;;
  *)
    echo "unexpected mock command: $command_name" >&2
    exit 2
    ;;
esac
