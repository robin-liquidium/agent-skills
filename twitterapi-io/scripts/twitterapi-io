#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

encrypted_credential="${HOME}/.config/credentials.encrypted/twitterapi-mcp-tunnel.env.cred"
credential_loader="${HOME}/.local/libexec/with-systemd-env-credential"
config_has_key=0
if [[ -r "$encrypted_credential" && -r "${HOME}/.config/twitterapi-io/config.json" ]] && \
  python3 - "${HOME}/.config/twitterapi-io/config.json" <<'PYCONFIG'
import json
import sys

try:
    value = json.load(open(sys.argv[1])).get("api_key")
    valid = (isinstance(value, str) and bool(value.strip()) and "\n" not in value and "\r" not in value) or (
        isinstance(value, dict)
        and set(value) == {"$agent_secret"}
        and isinstance(value["$agent_secret"], str)
        and bool(value["$agent_secret"])
    )
except (OSError, ValueError, TypeError, AttributeError):
    valid = False
raise SystemExit(0 if valid else 1)
PYCONFIG
then
  config_has_key=1
fi
if [[ "${TWITTERAPI_IO_SECURE_REEXEC:-}" != "1" \
  && "$config_has_key" != "1" \
  && -z "${TWITTERAPI_IO_KEY:-}" \
  && -r "$encrypted_credential" \
  && -x "$credential_loader" \
  && -x "$(command -v systemd-run 2>/dev/null || true)" ]]; then
  command_args=("$credential_loader" runtime.env "$SCRIPT_DIR/twitterapi-io" "$@")
  escaped_args=()
  for arg in "${command_args[@]}"; do
    escaped_args+=("${arg//\$/\$\$}")
  done
  exec systemd-run --user --quiet --wait --pipe --collect --same-dir \
    --setenv=TWITTERAPI_IO_SECURE_REEXEC=1 \
    --property="LoadCredentialEncrypted=runtime.env:${encrypted_credential}" \
    "${escaped_args[@]}"
fi

exec python3 "$SCRIPT_DIR/twitterapi_io.py" "$@"
